    # Byte-compiled / optimized / DLL files
    __pycache__/
    *.py[cod]
    *$py.class

    # C extensions
    *.so
    *.dll
    *.dylib

    # Distribution / packaging
    .Python
    build/
    dist/
    eggs/
    *.egg-info/
    .env/
    venv/
    env/

    # Editors
    .vscode/
    .idea/
    *.sublime-project
    *.sublime-workspace

    # Testing
    .pytest_cache/
    .coverage
    htmlcov/

    # Sphinx documentation
    docs/_build/

    # Jupyter Notebook
    .ipynb_checkpoints

    # Misc
    .DS_Store
    .env
